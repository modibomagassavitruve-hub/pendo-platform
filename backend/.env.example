# ===================================
# PENDO Backend - Environment Variables
# ===================================

# Environment
NODE_ENV=production

# Server
PORT=3001

# Database
# For PostgreSQL (Production):
DATABASE_URL=postgresql://user:password@host:5432/pendo
# For SQLite (Development):
# DATABASE_PATH=./data/pendo.db

# Frontend URL (for CORS)
FRONTEND_URL=https://pendo.vercel.app

# JWT Secret (generate a strong random string)
JWT_SECRET=your_very_long_and_secure_secret_key_here_min_32_chars

# API Keys (if needed for external services)
# BRVM_API_KEY=
# NEWS_API_KEY=

# Email (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logs
LOG_LEVEL=info

# Clé API Twelve Data (twelvedata.com)
TWELVE_DATA_KEY=
